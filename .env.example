# Variables de finance-service/docker-compose.yml. Copiar a .env en esta carpeta (no se versiona)
# y completar; docker compose lo lee solo al correrlo desde aquí. Fuera de Docker:
#   set -a; . ./.env; set +a; mvn spring-boot:run
#
# En producción, los mismos nombres con otros valores (README, "Despliegue a producción").

# finance_db (contenedor finance-db)
FINANCE_DB_USER=finance_svc
FINANCE_DB_PASSWORD=finance_svc

# RabbitMQ es del proyecto infra: iguales a los de ../.env.
RABBITMQ_USER=transporte
RABBITMQ_PASSWORD=transporte
